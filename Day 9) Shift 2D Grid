class Solution:
    def shiftGrid(self, grid: List[List[int]], k: int) -> List[List[int]]:
        m = len(grid)
        n = len(grid[0])
        total = m * n

        k %= total

        res = [[0] * n for _ in range(m)]

        for i in range(m):
            for j in range(n):
                pos = (i * n + j + k) % total
                new_i = pos // n
                new_j = pos % n
                res[new_i][new_j] = grid[i][j]

        return res
