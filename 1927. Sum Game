class Solution:
    def sumGame(self, num: str) -> bool:
        n = len(num)
        diff_sum = 0
        diff_q = 0
        
        for i in range(n // 2):
            if num[i] == '?':
                diff_q += 1
            else:
                diff_sum += int(num[i])
                
        for i in range(n // 2, n):
            if num[i] == '?':
                diff_q -= 1
            else:
                diff_sum -= int(num[i])
        return diff_q % 2 != 0 or diff_sum * 2 + diff_q * 9 != 0
